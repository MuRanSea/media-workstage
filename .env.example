# Volcengine Ark Configuration (Seedance 2.5/2.0, Seedream 5.0)
ARK_API_KEY=your_ark_api_key_here
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# MiniMax Configuration (Hailuo Video H3 / Video-01)
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_GROUP_ID=

# Local Server Configuration
PORT=8080
ASSET_DIR=./assets
DB_PATH=./data/media_workstage.db

# Optional Volcengine TOS Configuration (For large video reference uploads fallback)
TOS_ENABLE=false
TOS_ENDPOINT=https://tos-cn-beijing.volces.com
TOS_REGION=cn-beijing
TOS_BUCKET=your_tos_bucket_name
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
