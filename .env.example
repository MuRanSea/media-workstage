# Environment variables media-workstage.exe reads at startup. The program does not
# load this file: set the variables in your shell before starting it. Keys and base
# URLs saved in the settings UI take precedence; command-line flags override the
# server variables.

# Local server
PORT=8080
HOST=127.0.0.1
# 1 or true: do not open the browser on startup
NO_BROWSER=
DB_PATH=./data/media_workstage.db
ASSET_DIR=./assets
PROJECTS_DIR=./projects

# Volcengine Ark (Seedance video, Seedream image, Doubao text)
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# MiniMax (Hailuo video, text)
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_GROUP_ID=

# Kling
KLING_API_KEY=
KLING_BASE_URL=https://api-beijing.klingai.com

# Midjourney through an MJ Proxy protocol service; there is no official host
MIDJOURNEY_API_KEY=
MIDJOURNEY_BASE_URL=

# Google Gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# OpenAI, or an OpenAI-compatible relay
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# APIMart
APIMART_API_KEY=
APIMART_BASE_URL=https://api.apimart.ai/v1

# Upload Platform: Heighliner business API for the asset library and 7-day file links
# (upload cards). Separate from every provider; see docs/adr/0008-upload-platform.md
UPLOAD_API_KEY=
UPLOAD_BASE_URL=https://platform.sgt.site
